{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "atom-salon",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // An old deploy registered a `*/3 * * * *` cron. Wrangler only rewrites cron
  // triggers when the key is present, so dropping it from the config left the
  // schedule running against a Worker that exports no `scheduled()` handler:
  // 480 failed invocations a day, all of them logged as errors. An explicit
  // empty list is what actually unregisters it.
  "triggers": {
    "crons": []
  },
  // Smart Placement currently resolves to Mumbai (`cf-placement: remote-BOM`),
  // so every request from Jordan crosses to India and back. That only pays off
  // while MongoDB Atlas lives in the same region - if the cluster is moved
  // closer to the customers (e.g. AWS eu-central-1), drop this block.
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "PUBLIC_CACHE",
      "id": "5090150982e745f5a08a36ba26d048f5"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "atom-salon"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
  // On the Workers Paid plan, raise the per-request CPU ceiling from the free
  // plan's 10ms - that is the single change that removes the remaining
  // "Worker exceeded CPU time limit" 503s:
  //   "limits": { "cpu_ms": 30000 }
}
