# MongoDB Atlas (M0 free). Workers close TCP after every request, so a cluster
# far from Cloudflare (or from Jordan/Amman) makes every API call 2s+.
# Use a region close to you, e.g. AWS Frankfurt (eu-central-1) or Ireland.
# Network Access must allow 0.0.0.0/0 because Workers have no static IP.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/atom_salon
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
DEMO=false
# Web push (free). Generate once with `npm run vapid`. Never change them after
# launch, or every saved subscription stops working.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
